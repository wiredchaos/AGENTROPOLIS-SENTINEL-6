# Provider adapters are optional and runtime-specific.
# Never commit real credentials.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# Hermes/MCP adapter configuration
HERMES_ENDPOINT=
MCP_CONFIG_PATH=

# AEGIS integration
AEGIS_ENDPOINT=

# SENTINEL defaults
SENTINEL_MODE=closed-loop
SENTINEL_DEPLOY_AUTHORITY=false
